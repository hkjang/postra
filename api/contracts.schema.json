        },
        "since": {
          "type": "integer",
          "description": "inclusive sender-date lower bound, Unix seconds"
        },
        "until": {
          "type": "integer",
          "description": "exclusive sender-date upper bound, Unix seconds"
        },
        "time_zone": {
          "type": "string",
          "description": "IANA zone for relative dates; defaults to UTC"
        },
        "incomplete_only": {
          "type": "boolean",
          "description": "exclude completed work/actions; does not prove a mail is unanswered"
