        "question": {
          "type": "string",
          "description": "question to answer from your own mail and work evidence"
        },
        "account_id": {
          "type": "string",
          "description": "optional owned account"
        },
        "mode": {
          "type": "string",
          "description": "auto, keyword, semantic, hybrid, work, or actions"
        },
        "search_text": {
          "type": "string",
